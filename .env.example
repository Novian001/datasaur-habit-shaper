# Habit Shaper — environment contract (placeholders only; never commit real secrets).
# Copy to `.env` (gitignored) to override; compose provides dev defaults when unset.

# --- MySQL (db service) ---
MYSQL_DATABASE=habit_shaper
MYSQL_USER=habit_user
MYSQL_PASSWORD=habit_password
MYSQL_ROOT_PASSWORD=habit_root_password

# --- Backend ---
# JWT signing secret. Not consumed until the auth phase (Phase 3).
# Replace with a long random value for any real use.
JWT_SECRET=dev-insecure-jwt-secret-change-me

# Backend internal port (container). Published to host :3001 by compose.
PORT=3000

# Backend database connection — compose constructs this from the MYSQL_* vars
# above (mysql://<user>:<password>@db:3306/<database>). Override here only to
# point the backend elsewhere. Prisma consumes it from Phase 2 on.
# DATABASE_URL=mysql://habit_user:habit_password@db:3306/habit_shaper
